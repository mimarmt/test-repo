{
  "name": "sahne-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SketchUp modelini gerçek Google 3D çevresine oturtup açı onayıyla hiper-gerçekçi AI render üreten atölye",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "smoke": "playwright test",
    "yakala": "node scripts/capture.mjs",
    "render": "node scripts/render.mjs"
  },
  "dependencies": {
    "cesium": "^1.139.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@google/genai": "^1.0.0",
    "@playwright/test": "1.56.1",
    "playwright": "1.56.1",
    "sharp": "^0.34.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-static-copy": "^3.0.0",
    "vitest": "^3.0.0"
  }
}
