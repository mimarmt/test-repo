# Google Cloud anahtarı — projede şu API'ler etkin olmalı:
#   - Map Tiles API           (3D şehir dokusu için; tarayıcıdan çağrılır)
#   - Gemini API              (AI render için; render.mjs Node'dan çağırır)
# VITE_ öneki bu anahtarı tarayıcıya açar (3D Tiles bunu gerektirir).
VITE_GOOGLE_API_KEY=

# Opsiyonel: Gemini için ayrı sunucu anahtarı.
# Boş bırakılırsa render.mjs, VITE_GOOGLE_API_KEY'i kullanır.
GEMINI_API_KEY=
